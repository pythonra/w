--  Add new columns to the existing table
ALTER TABLE indian_cities
ADD COLUMN city_name VARCHAR(50),
ADD COLUMN city_type VARCHAR(10);


-- Update the city_name column with the appropriate city names
UPDATE indian_cities
SET city_name = CASE
    WHEN name = 'Kolkata' THEN 'Kolkata'
    WHEN name = 'Vishakapatanam' THEN 'Vishakapatanam'
    WHEN name = 'Chandigarh' THEN 'Chandigarh'
    WHEN name = 'Delhi' THEN 'Delhi'
    WHEN name = 'Lucknow' THEN 'Lucknow'
    ELSE city_name
END
WHERE name IN ('Kolkata', 'Vishakapatanam', 'Chandigarh', 'Delhi', 'Lucknow');


-- Update the city_type column to 'Major' for specified cities
UPDATE indian_cities
SET city_type = 'Major'
WHERE name IN ('Kolkata', 'Delhi');


-- Update the city_type column to 'Minor' for the remaining cities
UPDATE indian_cities
SET city_type = 'Minor'
WHERE name IN ('Vishakapatanam', 'Chandigarh', 'Lucknow');

-- Delete the record for "Route 1"
DELETE FROM indian_cities
WHERE name = 'Route 1';

-- Delete the record for the polygon named "Example Polygon"
DELETE FROM indian_cities
WHERE name = 'Example Polygon';
